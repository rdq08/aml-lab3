
# ==========================================
# AML Lab 3 - Git Ignore Configuration
# ==========================================

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/
.env
.env.*

# Python packaging
build/
dist/
*.egg-info/
.eggs/
*.egg

# Python testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook
.ipynb_checkpoints/

# ==========================================
# Machine Learning - Datasets
# ==========================================

# Never upload datasets to GitHub
data/*
!data/.gitkeep

tiny-imagenet/
tiny-imagenet-200/

# ==========================================
# Machine Learning - Model Checkpoints
# ==========================================

# Keep the folder structure but ignore saved models
checkpoints/*
!checkpoints/.gitkeep

*.pth
*.pt
*.ckpt
*.h5
*.hdf5

# ==========================================
# Weights & Biases
# ==========================================

wandb/

# ==========================================
# IDE and Operating System
# ==========================================

# Visual Studio Code
.vscode/

# PyCharm
.idea/

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# ==========================================
# Logs and temporary files
# ==========================================

*.log
*.tmp
*.bak

# ==========================================
# Keep project source files
# ==========================================

# The following files should be tracked by Git:
# models/*.py
# dataset/*.py
# utils/*.py
# train.py
# eval.py
# main.py
# requirements.txt
# README.md
